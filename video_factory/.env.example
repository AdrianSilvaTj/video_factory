# Copia este archivo como .env en la raíz video_factory y coloca tus claves reales.
# Pexels: https://www.pexels.com/api/ (solicita una API key)
PEXELS_API_KEY=PEGA_AQUI_TU_CLAVE_DE_PEXELS
# Pixabay: https://pixabay.com/api/docs/ (solicita una API key)
PIXABAY_API_KEY=PEGA_AQUI_TU_CLAVE_DE_PIXABAY
# Vecteezy (opcional): https://www.vecteezy.com/developers - necesitas el ID de cuenta y la clave
VECTEEZY_ACCOUNT_ID=PEGA_AQUI_TU_ID_DE_CUENTA
VECTEEZY_API_KEY=PEGA_AQUI_TU_CLAVE_DE_VECTEEZY
